use crate::benchmark::*;
use crate::build::*;
use crate::validate::Extraction;
use std::fs;
use tempfile::TempDir;

fn make_graph() -> MyGraph {
    let content = fs::read_to_string("tests/fixtures/extraction.json").unwrap();
    let ext: Extraction = serde_json::from_str(&content).unwrap();
    build_from_json(&ext)
}

fn write_graph(g: &MyGraph, path: &std::path::Path) {
    crate::export::to_json(g, &std::collections::HashMap::new(), path.to_str().unwrap());
}

#[test]
fn test_query_returns_positive_for_matching_question() {
    let g = make_graph();
    let tokens = query_subgraph_tokens(&g, "how does authentication work", 3);
    assert!(tokens > 0);
}

#[test]
fn test_query_returns_zero_for_no_match() {
    let g = make_graph();
    let tokens = query_subgraph_tokens(&g, "xyzzy plugh zorkmid", 3);
    assert_eq!(tokens, 0);
}

#[test]
fn test_run_benchmark_returns_reduction() {
    let dir = TempDir::new().unwrap();
    let graph_file = dir.path().join("graph.json");
    let g = make_graph();
    write_graph(&g, &graph_file);
    let result = run_benchmark(graph_file.to_str().unwrap(), Some(10_000), None);
    assert!(result.reduction_ratio > 1.0);
}

#[test]
fn test_run_benchmark_corpus_tokens_proportional() {
    let dir = TempDir::new().unwrap();
    let graph_file = dir.path().join("graph.json");
    let g = make_graph();
    write_graph(&g, &graph_file);
    let r1 = run_benchmark(graph_file.to_str().unwrap(), Some(1_000), None);
    let r2 = run_benchmark(graph_file.to_str().unwrap(), Some(10_000), None);
    assert!((r2.corpus_tokens as isize - (r1.corpus_tokens * 10) as isize).abs() <= r1.corpus_tokens as isize);
}

#[test]
fn test_run_benchmark_per_question_list() {
    let dir = TempDir::new().unwrap();
    let graph_file = dir.path().join("graph.json");
    let g = make_graph();
    write_graph(&g, &graph_file);
    let result = run_benchmark(graph_file.to_str().unwrap(), Some(5_000), Some(&["how does authentication work", "what is the main entry"]));
    assert!(!result.per_question.is_empty());
}

#[test]
fn test_run_benchmark_estimates_corpus_if_no_words() {
    let dir = TempDir::new().unwrap();
    let graph_file = dir.path().join("graph.json");
    let g = make_graph();
    write_graph(&g, &graph_file);
    let result = run_benchmark(graph_file.to_str().unwrap(), None, None);
    assert!(result.corpus_words > 0);
}

#[test]
fn test_run_benchmark_error_on_empty_graph() {
    let dir = TempDir::new().unwrap();
    let graph_file = dir.path().join("empty.json");
    let g = MyGraph::default();
    write_graph(&g, &graph_file);
    let result = run_benchmark(graph_file.to_str().unwrap(), Some(1_000), None);
    assert!(result.error.is_some());
}

#[test]
fn test_run_benchmark_includes_node_edge_counts() {
    let dir = TempDir::new().unwrap();
    let graph_file = dir.path().join("graph.json");
    let g = make_graph();
    write_graph(&g, &graph_file);
    let result = run_benchmark(graph_file.to_str().unwrap(), Some(5_000), None);
    assert_eq!(result.nodes, g.node_count());
    assert_eq!(result.edges, g.edge_count());
}
